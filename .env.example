DATABASE_URL=file:./hsm-aries.db
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Local development uses the SQLite URL above. Netlify supplies NETLIFY_DB_URL
# automatically after you create a Netlify Database.
# NEXT_PUBLIC_SITE_URL=https://hsmaries.space
# PAYLOAD_MAX_UPLOAD_BYTES=50000000
# Our own server (deploy/pi): DEPLOY_TARGET=node selects it – local PostgreSQL in DATABASE_URL, CMS uploads in
# MEDIA_DIR. The Pi's installer writes these into its own .env; nothing here is needed for local development.
# DEPLOY_TARGET=node
# MEDIA_DIR=/srv/aries/shared/media
# Form notifications and CMS password-reset mails (optional; without them form messages only appear in Mission
# Control → Inbox). Gmail: smtp.gmail.com, 465, the address and an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=hsmariesleapone@gmail.com
# SMTP_PASS=
# FORMS_NOTIFY_TO=hsmariesleapone@gmail.com
