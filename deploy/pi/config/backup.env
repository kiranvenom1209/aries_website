# /etc/aries-host/backup.env – where the encrypted nightly backups of the website go (bin/backup.sh).
# The default folder is on the Pi itself and does not survive a dead SSD: point it at the NAS once it is mounted,
# e.g. RESTIC_REPOSITORY="/mnt/nas/aries-backups", or at a cloud folder (rclone:<remote>:aries after `sudo rclone config`).
RESTIC_REPOSITORY="/var/backups/aries-restic"
RESTIC_PASSWORD_FILE="/etc/aries-host/secrets/restic.pass"
# optional Healthchecks.io URL pinged after every successful backup
HC_BACKUP_URL=""
